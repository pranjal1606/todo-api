{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "to do management api",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "todo-api"
  },
  "license": "ISC",
  "author": "pranjal",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate src/migrations/init -d src/config/database.ts",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.1",
    "joi-password-complexity": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typeorm": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
